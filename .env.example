# Проще не заполнять руками, а запустить мастер: ./deploy/init-env.sh
# Он спросит данные приложения Discord и сам сгенерирует пароли и секреты.
# Файл .env в git не попадает, никогда не коммить его.
# Репозиторий публичный: любой секрет, попавший в историю git, считай утёкшим и сразу меняй.
#
# Токены ботов здесь больше не нужны: они задаются в панели, раздел «Подключение» у каждого бота,
# и хранятся зашифрованными ключом самого бота.

# --- Вход в панель через Discord: https://discord.com/developers/applications ---
# Приложение, через которое администраторы входят в панель.
# General Information → Application ID.
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret.
DISCORD_CLIENT_SECRET=
# ID твоего сервера Discord (ПКМ по серверу → Копировать ID сервера, нужен режим разработчика).
GUILD_ID=

# --- Панель ---
# Полный адрес панели. В OAuth2 → Redirects добавь <PANEL_URL>/api/auth/callback
PANEL_URL=http://localhost:3000
# Минимум 32 случайных символа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=
# true, только если панель стоит за твоим reverse proxy (Caddy, nginx). Иначе false.
TRUST_PROXY=false
# Порт панели на 127.0.0.1. Для тестовой копии на том же сервере: 3001.
PANEL_PORT=3000
# Порт API бота привязки Steam на 127.0.0.1 (наружу его отдаёт Caddy по <PANEL_URL>/link-api).
# Для тестовой копии: 3011.
LINK_API_PORT=3010

# --- Docker ---
# Имя копии: у рабочей и тестовой копии на одном сервере должны быть разные имена,
# тогда у них раздельные базы и контейнеры. На сервере: flamebot и flamebot-staging.
# COMPOSE_PROJECT_NAME=flamebot

# --- База данных ---
# Для docker compose: пароль из букв и цифр, например openssl rand -hex 24
POSTGRES_PASSWORD=
# Для локальной разработки без docker compose (pnpm dev:*):
DATABASE_URL=postgresql://flamebot:ПАРОЛЬ@localhost:5432/flamebot

# --- Бот онлайна серверов ---
# true — разрешить RCON на адреса локальной сети. По умолчанию запрещено. Эта настройка
# намеренно не вынесена в панель: взломанная панель не должна открывать доступ к внутренней сети.
ALLOW_PRIVATE_RCON=false

# --- Старые переменные (необязательны) ---
# Если они заданы, боты один раз переносят значения в базу зашифрованными (токены) или в свой
# том (ключ онлайна). После первого запуска новой версии строки можно удалить.
# DISCORD_TOKEN=
# GIVEAWAY_DISCORD_TOKEN=
# ONLINE_SECRET_KEY=
