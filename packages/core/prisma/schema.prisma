// Общая схема базы для веб-панели и ботов.
// Панель задумана как единое место для нескольких ботов одного сервера Discord (GUILD_ID):
//   - общие таблицы платформы: Panel*, Guild*, BotStatus, AdminSession, AuditLog;
//   - таблицы каждого бота живут в своём разделе схемы (сейчас это рейтинг-бот).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Платформа =====================

// Единственная строка с id = 1.
model PanelSettings {
  id Int @id @default(1)
  // Роли, которым открыт доступ к панели (кроме владельца и администраторов сервера).
  panelRoleIds String[] @default([])
  updatedAt    DateTime @updatedAt
}

// ===================== Рейтинг-бот (модуль "rating") =====================

// Единственная строка с id = 1.
model RatingSettings {
  id Int @id @default(1)

  // Опыт за сообщение, как в JuniperBot: 15–24 не чаще раза в минуту. Целые границы — целый опыт.
  // Ранг может задать своё начисление; null у ранга — эти значения.
  xpMin            Decimal @default(15) @db.Decimal(10, 2)
  xpMax            Decimal @default(24) @db.Decimal(10, 2)
  xpCooldownSec    Int     @default(60)
  minMessageLength Int     @default(5)
  scrapPerAward    Decimal @default(0.03) @db.Decimal(10, 2)
  // Опыт за голос, как в JuniperBot: каждую минуту voiceXpPerMember за каждого в канале
  // с включённым микрофоном (считая себя), если таких хотя бы двое. AFK-канал не считается.
  voiceXpEnabled   Boolean @default(true)
  voiceXpPerMember Int     @default(6)

  announceRankUp    Boolean  @default(true)
  announceChannelId String?
  rankUpMessage     String   @default("{user} дорос до ранга «{rank}» и получает {reward} {scrap_icon}")
  removeOldRankRoles Boolean @default(false)

  // Каналы, где начисляется опыт. Пустой список — опыт начисляется во всех каналах.
  xpChannelIds      String[] @default([])
  commandChannelIds String[] @default([])

  repCooldownHours  Int @default(24)
  repSameTargetDays Int @default(7)
  repMinMemberDays  Int @default(3)

  // Личные роли проходят проверку администрации перед выдачей.
  customRoleApproval Boolean @default(true)
  // Канал, куда приходят заявки на личные роли.
  approvalChannelId  String?

  // /profile картинкой (true) или текстовой карточкой (false).
  profileCardEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model Rank {
  id          Int      @id @default(autoincrement())
  name        String
  emoji       String?
  // Ранг даётся с уровня minLevel; minXp — опыт этого уровня по формуле JuniperBot (считается при сохранении).
  minLevel    Int      @unique
  minXp       Int      @unique
  roleId      String?
  scrapReward Int      @default(0)
  // Начисление за сообщение на этом ранге. null — как в общих настройках.
  xpMin           Decimal? @db.Decimal(10, 2)
  xpMax           Decimal? @db.Decimal(10, 2)
  scrapPerMessage Decimal? @db.Decimal(10, 2)
  members     Member[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id           String    @id // Discord user id
  username     String
  displayName  String
  avatarHash   String?
  xp           Decimal   @default(0) @db.Decimal(14, 2)
  scrap        Decimal   @default(0) @db.Decimal(14, 2)
  rep          Int       @default(0)
  messageCount Int       @default(0)
  // Голос: сколько секунд провёл в голосовых каналах и сколько из общего опыта (xp) получено за голос.
  // Начисление за голос появится позже; время в голосе переносится из JuniperBot.
  voiceSeconds Int       @default(0)
  voiceXp      Decimal   @default(0) @db.Decimal(14, 2)
  lastXpAt     DateTime?
  rankId       Int?
  rank         Rank?     @relation(fields: [rankId], references: [id], onDelete: SetNull)
  // Награда за ранг выдаётся один раз: за ранги с порогом выше этого значения.
  rewardedUpToXp Int     @default(0)
  // Скрап за ранги, выданный кнопкой «Выдать награды за ранги» тем, кому их отметили без выплаты.
  rankScrapGranted Int   @default(0)
  // Панель ставит флаг, когда меняет опыт или ранги; бот пересчитывает роли в фоне.
  needsRoleSync Boolean  @default(false)
  // Импорт ставит флаг, а бот проверяет, есть ли человек на сервере, и обновляет имя. Роли не трогает.
  needsMemberCheck Boolean @default(false)
  inGuild      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  repGiven    RepTransaction[] @relation("RepGiver")
  repReceived RepTransaction[] @relation("RepReceiver")
  purchases   Purchase[]
  badges      MemberBadge[]

  @@index([xp(sort: Desc)])
  @@index([rep(sort: Desc)])
  @@index([scrap(sort: Desc)])
  @@index([lastXpAt])
  @@index([needsRoleSync])
  @@index([needsMemberCheck])
}

model RepTransaction {
  id         Int      @id @default(autoincrement())
  giverId    String
  receiverId String
  amount     Int      @default(1)
  giver      Member   @relation("RepGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver   Member   @relation("RepReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([giverId, createdAt])
  @@index([giverId, receiverId, createdAt])
}

enum ShopItemType {
  ROLE        // готовая роль сервера (например, цвет ника)
  CUSTOM_ROLE // личная роль: название и цвет выбирает покупатель
  BADGE       // бейдж в профиль
}

model ShopItem {
  id           Int          @id @default(autoincrement())
  name         String
  description  String       @default("")
  type         ShopItemType
  price        Int
  roleId       String?
  durationDays Int?
  badgeLabel   String?
  enabled      Boolean      @default(true)
  stock        Int?
  sortOrder    Int          @default(0)
  purchases    Purchase[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Purchase {
  id         Int       @id @default(autoincrement())
  memberId   String
  itemId     Int
  price      Int
  roleId     String?
  customName String?
  expiresAt  DateTime?
  active     Boolean   @default(true)
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  item       ShopItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  request    CustomRoleRequest?
  createdAt  DateTime  @default(now())

  @@index([active, expiresAt])
  @@index([memberId])
}

enum CustomRoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// Заявка на личную роль. Скрап списан при подаче и возвращается при отказе.
model CustomRoleRequest {
  id            Int                     @id @default(autoincrement())
  purchaseId    Int                     @unique
  purchase      Purchase                @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  memberId      String
  name          String
  color         Int?
  status        CustomRoleRequestStatus @default(PENDING)
  channelId     String?
  messageId     String?
  decidedById   String?
  decidedByName String?
  reason        String?
  createdAt     DateTime                @default(now())
  decidedAt     DateTime?

  @@index([status, createdAt])
  @@index([memberId, status])
}

model MemberBadge {
  id        Int      @id @default(autoincrement())
  memberId  String
  label     String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([memberId, label])
}

// Шаблон картинки /profile. Единственная строка с id = 1, layout проверяется
// схемой cardLayoutSchema из packages/core/src/card.
model ProfileCard {
  id        Int      @id @default(1)
  layout    Json
  updatedAt DateTime @updatedAt
}

// Сохранённые варианты карточки: их можно открыть в редакторе и сделать текущей.
model CardPreset {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Картинки для карточки (фон, логотипы). Хранятся в базе, потому что контейнеры
// работают с read-only файловой системой. Панель перекодирует каждую загрузку.
model CardAsset {
  id        Int      @id @default(autoincrement())
  mime      String
  width     Int
  height    Int
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model DailyStat {
  date       DateTime @id @db.Date
  messages   Int      @default(0)
  xpAwarded  Decimal  @default(0) @db.Decimal(14, 2)
  scrapSpent Int      @default(0)
}

// ===================== Бот онлайна серверов (модуль "online") =====================

// Единственная строка с id = 1.
model OnlineSettings {
  id                Int      @id @default(1)
  pollIntervalMs    Int      @default(5000)
  connectTimeoutMs  Int      @default(15000)
  responseTimeoutMs Int      @default(60000)
  offlineText       String   @default("Сервер выключен")
  startingText      String   @default("Сервер запускается")
  onlineText        String   @default("Онлайн: {players}/{max} игроков")
  queueText         String   @default("Онлайн: {players}/{max} ({queued} в очереди)")
  updatedAt         DateTime @updatedAt
}

// Игровой сервер и Discord-бот, который показывает его онлайн в статусе.
// Пароль RCON и токен Discord зашифрованы открытым ключом бота (см. core/src/secrets.ts).
model OnlineServer {
  id               Int                 @id @default(autoincrement())
  name             String
  host             String
  port             Int
  rconPasswordEnc  String?
  discordTokenEnc  String?
  secretsUpdatedAt DateTime?
  enabled          Boolean             @default(true)
  sortOrder        Int                 @default(0)
  status           OnlineServerStatus?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

enum OnlineState {
  OFFLINE
  STARTING
  ONLINE
  DISABLED
}

model OnlineServerStatus {
  serverId    Int          @id
  server      OnlineServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  state       OnlineState  @default(OFFLINE)
  players     Int?
  maxPlayers  Int?
  queued      Int?
  botTag      String?
  botError    String?
  rconError   String?
  lastSeenAt  DateTime?
  // О чём последний раз знают получатели в Telegram: ONLINE или OFFLINE (null — ещё ни о чём).
  // Хранится в базе, чтобы после перезапуска бота не повторять и не терять уведомления.
  alertState  OnlineState?
  // С какого момента сервер не работает — для «был выключен 15 мин».
  downSince   DateTime?
  updatedAt   DateTime     @updatedAt
}

// Уведомления в Telegram о выключении и включении серверов. Единственная строка с id = 1.
// Отдельно от OnlineSettings: их смена не должна переподключать Discord-ботов серверов.
model OnlineTelegram {
  id              Int       @id @default(1)
  // Куда слать: ID пользователей, групп (с минусом) или @username публичных каналов.
  chatIds         String[]  @default([])
  notifyOffline   Boolean   @default(true)
  notifyOnline    Boolean   @default(true)
  // Сколько сервер должен пролежать, прежде чем сообщать: короткий обрыв RCON не тревога.
  delaySec        Int       @default(60)
  offlineText     String    @default("🔴 Сервер {server} выключился")
  onlineText      String    @default("🟢 Сервер {server} снова работает. Был выключен {downtime}")
  // Токен бота зашифрован открытым ключом бота онлайна: панель и база его прочитать не могут.
  tokenEnc        String?
  tokenHint       String?
  tokenSetAt      DateTime?
  tokenSetByName  String?
  // Что видит бот: под каким именем вошёл в Telegram или почему не смог.
  botUsername     String?
  botError        String?
  // Пробное сообщение: панель ставит testRequestedAt, бот отправляет и записывает результат.
  testRequestedAt DateTime?
  testDoneAt      DateTime?
  testResult      String?
  testOk          Boolean?
  updatedAt       DateTime  @updatedAt
}

// ===================== Бот розыгрышей (модуль "giveaway") =====================

// Единственная строка с id = 1.
model GiveawaySettings {
  id            Int     @id @default(1)
  // Часовой пояс, в котором админы вводят дату и время итогов (IANA, например Asia/Vladivostok).
  timezone      String  @default("Asia/Vladivostok")
  timezoneLabel String  @default("Владивосток")
  // Сообщение победителю в ЛС. {prize} — приз, {code} — промокод.
  promoDmText   String  @default("Привет!\nТы победил в розыгрыше **«{prize}»** в дискорд канале **[FlameRust](https://discord.flamerust.ru)**!\n\n**Твой промокод: {code}**\n\nАктивировать его можно на нашем сайте [FlameRust.GG](https://flamerust.gg) в профиле.\nСрок действия промокода: 1 неделя\n\nСпасибо что играешь на наших серверах!")
  // Команда «/розыгрыш быстрый»: после неё остаётся только ввести промокоды.
  quickPrize        String  @default("Промокод на 50 рублей")
  quickWinners      Int     @default(5)
  // 0 — сегодня, 1 — завтра, 2 — послезавтра...
  quickDaysAhead    Int     @default(1)
  quickTime         String  @default("23:00")
  quickBoostersOnly Boolean @default(false)
  updatedAt     DateTime @updatedAt
}

enum GiveawayStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model Giveaway {
  id           Int            @id @default(autoincrement())
  channelId    String
  messageId    String?        @unique
  hostId       String
  prize        String
  description  String?
  winnersCount Int
  // Время итогов. После завершения — когда итоги подведены на самом деле.
  endsAt       DateTime
  boostersOnly Boolean        @default(false)
  status       GiveawayStatus @default(ACTIVE)
  winners      String[]       @default([])
  // Панель ставит флаг, когда отменяет розыгрыш; бот перерисовывает сообщение в канале.
  needsMessageUpdate Boolean  @default(false)
  // Розыгрыш создан в панели и ждёт, пока бот отправит его в канал (у панели нет токена).
  needsPublish Boolean        @default(false)
  // Почему бот не смог опубликовать розыгрыш из панели. Показывается на странице розыгрыша.
  publishError String?
  entries      GiveawayEntry[]
  promoCodes   GiveawayPromoCode[]
  createdAt    DateTime       @default(now())

  @@index([status, endsAt])
  @@index([needsMessageUpdate])
  @@index([needsPublish])
}

model GiveawayEntry {
  giveawayId Int
  userId     String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@id([giveawayId, userId])
}

// Промокоды победителям: по одному на победителя, приходят в ЛС.
model GiveawayPromoCode {
  id         Int      @id @default(autoincrement())
  giveawayId Int
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  code       String
  // Кому выдан. null — ещё не выдан.
  userId     String?
  // Дошло ли сообщение в ЛС.
  dmSent     Boolean  @default(false)

  @@index([giveawayId])
}

// ===================== Карты вайпов (модуль "maps") =====================
// Бот заказывает карты на RustMaps под расписание вайпов, заливает выбранные в S3,
// шлёт анонс в Discord и записывает ссылки в задачи вайпа Pterodactyl.
// Управление — из панели и кнопками в Telegram, логика одна: в боте.

// Единственная строка с id = 1.
model MapsSettings {
  id                 Int      @id @default(1)
  // Пояс расписания: время вайпов в правилах и во всех сообщениях.
  timezone           String   @default("Europe/Moscow")
  timezoneLabel      String   @default("МСК")
  // Анонс в Discord уходит за sendLeadHours до вайпа, генерация начинается ещё за genLeadHours до анонса.
  sendLeadHours      Float    @default(24)
  genLeadHours       Float    @default(10)
  // Автоподбор: бот сам выбирает лучшие карты из пула и предлагает набор целиком.
  autoPick           Boolean  @default(false)
  // Запись ссылок в Pterodactyl: спросить за panelAskHours до вайпа, напоминать, записать самим за panelAutoMinutes.
  panelAskHours      Int      @default(8)
  panelRemindMinutes Int      @default(60)
  panelAutoMinutes   Int      @default(30)
  // Telegram: кто может нажимать кнопки (user id) и куда слать сообщения (пусто — первому админу).
  telegramAdminIds   String[] @default([])
  telegramChatId     String?
  rustmapsOrgId      String?
  s3Endpoint         String   @default("")
  s3Region           String   @default("")
  s3Bucket           String   @default("")
  s3Prefix           String   @default("maps")
  // path или virtual: как адресовать бакет.
  s3Addressing       String   @default("path")
  // Публичный адрес бакета: ссылка на карту = cdnBaseUrl/<ключ объекта>.
  cdnBaseUrl         String   @default("")
  pteroUrl           String?
  // Веса оценки карт (core/src/mapsScoring.ts). null — значения по умолчанию.
  scoring            Json?
  updatedAt          DateTime @updatedAt
}

// Секреты бота карт: токен Telegram, ключи RustMaps, S3 и Pterodactyl, вебхук Discord.
// Шифруются открытым ключом бота, панель прочитать их не может.
model MapsSecret {
  name      String   @id
  valueEnc  String
  // Безопасная подсказка, чтобы было видно, что сохранено (последние символы, без самого секрета).
  hint      String?
  setAt     DateTime @default(now())
  setById   String?
  setByName String?
}

// Игровой сервер, для которого подбираются карты.
model MapsServer {
  id          Int      @id // номер сервера: FR #1, FR #2...
  title       String
  // Папка в S3: <s3Prefix>/<folder>/<файл>.map
  folder      String
  size        Int
  // Имя сохранённой конфигурации на RustMaps.
  savedConfig String
  // Идентификатор сервера в Pterodactyl (из адреса /server/<id>). Пусто — ссылки в панель не пишутся.
  pteroUuid   String?
  updatedAt   DateTime @updatedAt
}

// Правило расписания: в какой день недели и во сколько вайп, какие серверы, сколько карт заказывать.
model MapsWipeRule {
  key            String    @id
  weekday        Int // 0 — понедельник, 6 — воскресенье
  time           String // "14:00" по поясу настроек
  serverIds      Int[]
  // Сколько карт генерировать за раз по каждой сохранённой конфигурации: { "4000_Modded": 3 }.
  pool           Json
  // Тело сообщения вебхука Discord. {view:N} и {download:N} — ссылки на карту сервера N.
  template       Json
  // В первую неделю месяца время вайпа берётся из другого пояса (форс-вайп по времени США).
  forceTimezone  String?
  forceTime      String?
  // Глобальный вайп (в Pterodactyl включается «Wipe Blueprints»): первый такой день месяца
  // и/или каждые bpEveryDays дней от bpAnchor.
  bpFirstOfMonth Boolean   @default(false)
  bpEveryDays    Int       @default(0)
  bpAnchor       DateTime? @db.Date
  enabled        Boolean   @default(true)
  updatedAt      DateTime  @updatedAt
}

// Цикл — подготовка карт к одному вайпу.
// status: generating -> scheduled (авто-отправка в sendAt) -> sending -> sent;
//         ответвления: awaiting_discord (только вручную), skipped.
model MapsCycle {
  id              String          @id // например "thursday-2026-10-22"
  ruleKey         String
  wipeAt          DateTime
  sendAt          DateTime
  status          String
  staging         Boolean         @default(false)
  blueprints      Boolean         @default(false)
  // Время анонса прошло, а карты не готовы: предупреждение уже отправлено.
  warned          Boolean         @default(false)
  // Идёт автоподбор: показываем набор целиком. autoMsgId -1 — сообщение отправляется.
  autoMode        Boolean         @default(false)
  autoMsgId       Int?
  promptMsgId     Int?
  // Запись ссылок в Pterodactyl: idle -> pending (спросили) -> done | skipped.
  panelState      String          @default("idle")
  panelMsgId      Int?
  panelNotifiedAt DateTime?
  createdAt       DateTime        @default(now())
  slots           MapsSlot[]
  candidates      MapsCandidate[]

  @@index([status])
  @@index([wipeAt])
}

// Карта сервера в цикле. status: waiting -> ready -> uploading -> uploaded | error.
// source: rustmaps | manual (загружена вручную).
model MapsSlot {
  id           Int       @id @default(autoincrement())
  cycleId      String
  cycle        MapsCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  serverId     Int
  size         Int
  config       String
  attempt      Int       @default(1)
  seed         Int?
  rmMapId      String?
  status       String
  info         Json?
  viewUrl      String?
  s3Key        String?
  cdnUrl       String?
  error        String?
  source       String    @default("rustmaps")
  candId       Int?
  tgMsgId      Int?
  tgPhotoMsgId Int?
  // Ссылка записана в задачу вайпа в Pterodactyl.
  panelSynced  Boolean   @default(false)
  panelNote    String?

  @@index([cycleId])
  @@index([status])
}

// Карта из пула вайпа. status: queued -> generating -> ready -> assigned | rejected | error.
model MapsCandidate {
  id            Int       @id @default(autoincrement())
  cycleId       String
  cycle         MapsCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  size          Int
  config        String
  seed          Int?
  rmMapId       String?
  status        String
  info          Json?
  viewUrl       String?
  error         String?
  // Какому серверу карта показывалась.
  slotId        Int?
  // Порядок пролистывания (для «Назад») и отложенные кнопкой «Назад».
  rejectedOrder Int?
  parkedOrder   Int?
  createdAt     DateTime  @default(now())

  @@index([cycleId, size, config, status])
  @@index([status])
}

// Действия из панели. Логика карт живёт в боте, поэтому панель ставит задание сюда,
// а бот выполняет его за пару секунд и правит сообщения в Telegram.
model MapsAction {
  id        Int       @id @default(autoincrement())
  kind      String
  args      Json
  // pending -> done | error
  status    String    @default("pending")
  result    String?
  details   Json?
  byId      String?
  byName    String?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([status, id])
}

// ===================== Объявления о вайпах (модуль "notices") =====================
// Перенос Python-бота msg_wipe_bot: за несколько часов до вайпа админы в Telegram или в панели
// подтверждают текст, в назначенное время бот публикует его в Discord и ВКонтакте
// и создаёт промокод в gamestores. Плюс утренний план дня и напоминания с кнопкой.

// Единственная строка с id = 1.
model NoticeSettings {
  id                  Int      @id @default(1)
  timezone            String   @default("Europe/Moscow")
  timezoneLabel       String   @default("МСК")
  // Когда присылать текст на подтверждение и когда напоминать, если не подтвердили.
  notifyMinutes       Int      @default(600)
  remindMinutes       Int      @default(60)
  // Бот был выключен и время отправки прошло больше чем на столько — не отправлять.
  maxLateMinutes      Int      @default(30)
  // Пробный режим: наружу ничего не уходит, промокоды не создаются.
  dryRun              Boolean  @default(false)
  telegramAdminIds    String[] @default([])
  // ВКонтакте: сообщество и заранее загруженные фото (токен сообщества не может загружать фото, ошибка 27).
  vkGroupId           Int?
  vkPhotoRegular      String?
  vkPhotoGlobal       String?
  testVkGroupId       Int?
  testVkPhotoRegular  String?
  testVkPhotoGlobal   String?
  // Промокод gamestores: общий код, тип, срок действия после вайпа.
  gamestoresStoreId   String?
  promoCode           String   @default("FLAMEWIPE")
  promoType           String   @default("discount")
  promoDaysAfter      Int      @default(1)
  promoEndTime        String   @default("23:59")
  promoLimitUses      Int      @default(0)
  // Тестовые прогоны создают настоящий тестовый промокод (TEST-…, 1%, одно использование).
  promoTestReal       Boolean  @default(false)
  // План дня и напоминания.
  agendaEnabled       Boolean  @default(true)
  agendaSendAt        String   @default("05:00")
  agendaGraceMinutes  Int      @default(240)
  agendaGreeting      String   @default("Доброе утро!")
  updatedAt           DateTime @updatedAt
}

// Токены и ключи, зашифрованные открытым ключом бота: панель и база их прочитать не могут.
model NoticeSecret {
  name      String   @id
  valueEnc  String
  hint      String?
  setAt     DateTime @default(now())
  setById   String?
  setByName String?
}

// Текст объявления: тело вебхука Discord и пост ВКонтакте. Подстановки {date} {time} {weekday} {ts}.
model NoticeTemplate {
  id          String   @id // латиницей, едет в кнопки Telegram
  title       String
  kind        String // regular | global
  discord     Json
  vk          String
  // Скидка промокода в процентах; null — промокод этому тексту не нужен.
  promoAmount Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Правило расписания: день недели, время и когда вайп глобальный. Расчёт тот же, что у бота карт.
model NoticeRule {
  key               String    @id
  weekday           Int // 0 = понедельник
  time              String
  forceTimezone     String?
  forceTime         String?
  bpFirstOfMonth    Boolean   @default(false)
  bpEveryDays       Int       @default(0)
  bpAnchor          DateTime? @db.Date
  // Тексты по умолчанию: уходят, если админы не выбрали другой.
  regularTemplateId String?
  globalTemplateId  String?
  enabled           Boolean   @default(true)
  updatedAt         DateTime  @updatedAt
}

// Вайп и его объявление. key — местное время вайпа «2026-10-22T17:00» (у тестовых «t…»).
// status: pending -> sending -> sent | partial; либо skipped / missed.
model NoticeEvent {
  key         String   @id
  wipeAt      DateTime
  kind        String
  templateId  String
  status      String   @default("pending")
  confirmed   Boolean  @default(false)
  confirmedBy String?
  notified    Boolean  @default(false)
  reminded    Boolean  @default(false)
  isTest      Boolean  @default(false)
  // {"discord": {"state": "ok|dry|error", "detail": "…"}, "vk": {…}, "promo": {…}}
  results     Json     @default("{}")
  // Сообщения Telegram с кнопками: [[chatId, messageId], …]. Их обновляет и гасит бот.
  msgs        Json     @default("[]")
  // Созданный ботом промокод: {"id", "code", "amount", "date_end"}.
  promo       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, wipeAt])
  @@index([wipeAt(sort: Desc)])
}

// План дня: пункты по дням недели (0 = понедельник). Подстановки {wipe_time} {wipe_kind} {promo}.
model NoticeAgendaDay {
  weekday Int      @id
  items   String[]
}

// Напоминание с кнопкой: приходит по расписанию, пока не нажмут «Готово».
model NoticeReminder {
  id           String   @id
  title        String
  text         String
  button       String   @default("✅ Готово")
  doneText     String   @default("Больше сегодня не напомню.")
  days         Int[]
  times        String[]
  graceMinutes Int      @default(60)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// Что из плана дня и напоминаний уже отправлено: "agenda:2026-10-22", "remind:giveaway:2026-10-22".
model NoticeDaily {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// Картинка поста по типу вайпа (regular | global). Прикрепляется к Discord и ВКонтакте.
model NoticeImage {
  kind          String   @id
  data          Bytes
  mime          String
  size          Int
  updatedAt     DateTime @updatedAt
  updatedByName String?
}

// Задания из панели для бота: подтвердить, сменить текст, отменить, тест, проверка подключений.
model NoticeAction {
  id        Int       @id @default(autoincrement())
  kind      String
  args      Json
  // pending -> running -> done | error
  status    String    @default("pending")
  result    String?
  details   Json?
  byId      String?
  byName    String?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([status, id])
}

// ===================== Платформа: общие данные сервера =====================

// Открытые ключи ботов для шифрования секретов. Приватные ключи есть только у ботов.
model BotPublicKey {
  botKey    String   @id
  publicKey String
  updatedAt DateTime @updatedAt
}

// Токен Discord бота, который вводится в панели. Панель шифрует его открытым ключом бота
// (BotPublicKey) и прочитать обратно не может: расшифровывает только сам бот.
model BotCredential {
  botKey          String    @id
  discordTokenEnc String?
  tokenSetAt      DateTime?
  tokenSetById    String?
  tokenSetByName  String?
  updatedAt       DateTime  @updatedAt
}

// Снимок ролей и каналов сервера. Его пишет бот, панель только читает,
// поэтому токены ботов веб-панели не нужны.
model GuildRole {
  id          String   @id
  name        String
  color       Int
  position    Int
  permissions String
  managed     Boolean
  updatedAt   DateTime @updatedAt
}

model GuildChannel {
  id        String   @id
  name      String
  type      Int
  position  Int
  parentId  String?
  updatedAt DateTime @updatedAt
}

// Единственная строка с id = 1. Пишет любой бот платформы.
model GuildInfo {
  id          Int      @id @default(1)
  name        String
  iconHash    String?
  ownerId     String
  memberCount Int
  updatedAt   DateTime @updatedAt
}

// Каждый бот раз в минуту отмечается здесь под своим ключом (например, "rating").
// state — что бот делает на самом деле: running (работает), paused (остановлен из панели)
// или failed (включён, но не смог войти в Discord).
model BotStatus {
  botKey      String   @id
  heartbeatAt DateTime
  state       String   @default("running")
  // Под каким аккаунтом бот вошёл в Discord и почему не смог войти. Пишет сам бот.
  discordUserId  String?
  discordUserTag String?
  discordAvatar  String?
  loginError     String?
}

// Включён ли бот. Панель меняет флаг, бот проверяет его каждые несколько секунд:
// выключенный бот отключается от Discord, но процесс остаётся и ждёт команды на запуск.
model BotControl {
  botKey        String   @id
  enabled       Boolean  @default(true)
  changedById   String?
  changedByName String?
  updatedAt     DateTime @updatedAt
}

enum EventLevel {
  INFO
  WARN
  ERROR
}

// История событий ботов: покупки, ранги, заявки, сбои. Пишут боты, панель показывает.
model BotEvent {
  id        Int        @id @default(autoincrement())
  botKey    String
  level     EventLevel @default(INFO)
  type      String
  memberId  String?
  message   String
  details   Json?
  createdAt DateTime   @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([botKey, level, createdAt(sort: Desc)])
  @@index([memberId, createdAt(sort: Desc)])
  @@index([type])
}

model AdminSession {
  id             String   @id // sha256 от токена из cookie; сам токен в базе не хранится
  userId         String
  username       String
  avatarHash     String?
  isGuildAdmin   Boolean
  accessTokenEnc String // OAuth-токен Discord, зашифрован AES-256-GCM
  ip             String?
  userAgent      String?
  expiresAt      DateTime
  lastVerifiedAt DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  module    String   // "panel", "rating", ...
  actorId   String
  actorName String
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([module, createdAt(sort: Desc)])
}
