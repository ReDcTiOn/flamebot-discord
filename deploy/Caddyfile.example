# Образец для /etc/caddy/Caddyfile. Домены работают через Cloudflare (оранжевое облако),
# у каждого A-запись на IP сервера. Caddy сам выпустит и будет продлевать HTTPS-сертификаты.
# После правки: sudo systemctl reload caddy
{
	servers {
		# Запросы приходят от Cloudflare. Настоящий IP игрока берём из CF-Connecting-IP,
		# но только если запрос пришёл с адреса Cloudflare: иначе заголовок можно подделать.
		# Список: https://www.cloudflare.com/ips/ (меняется редко, сверяй раз в полгода).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Общие настройки панели: сжатие и один проверенный IP игрока для панели
# (по нему работают ограничения на вход и журнал действий).
(panel) {
	encode zstd gzip
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
	}
}

bots.flamerust.gg {
	import panel 127.0.0.1:3000
}

# Тестовая копия (ветка dev). Удали блок, если тестовая копия не нужна.
# Имя именно bots-staging, а не staging.bots: бесплатный сертификат Cloudflare
# покрывает только один уровень поддоменов (*.flamerust.gg).
bots-staging.flamerust.gg {
	import panel 127.0.0.1:3001
}
